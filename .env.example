# SnapClass Environment Configuration
# Copy this file to .env and replace the values with your Supabase credentials

# 1. Supabase Project URL (Supabase -> Project Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase API Key (Supabase -> Project Settings -> API -> Project API Keys -> anon / service_role)
SUPABASE_KEY=your-supabase-anon-or-service-key

# 3. Streamlit App URL (Used for generating student enrollment QR codes and links)
APP_URL=http://localhost:8501
